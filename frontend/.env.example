# ─────────────────────────────────────────────────────────────────────────
# AOS Frontend Environment Variables
#
# Copy to `.env` for local dev, or set in Vercel project settings for prod.
# All Vite env vars MUST be prefixed `VITE_` to be exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────

# ─── API endpoint ────────────────────────────────────────────────────────
# REQUIRED. Your deployed Django backend.
# VITE_API_URL=https://api.aos-swarm.com/api

# ─── Google Sign-In ──────────────────────────────────────────────────────
# Get from https://console.cloud.google.com/apis/credentials
# Use the OAuth 2.0 Client ID (Web application). Add your frontend origin
# (e.g. https://agentic-enterprise-smoky.vercel.app) to "Authorized
# JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# ─── GitHub OAuth ────────────────────────────────────────────────────────
# https://github.com/settings/developers → OAuth Apps → New
# Callback URL: <frontend_url>/auth/github/callback
VITE_GITHUB_CLIENT_ID=

# ─── Sentry (error tracking + session replay) ────────────────────────────
# https://sentry.io/settings/projects/  → Client Keys (DSN)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# ─── PostHog (product analytics + session replay) ────────────────────────
# https://app.posthog.com/project/settings  → "Project API Key"
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# ─── Mixpanel (alternative analytics) ────────────────────────────────────
# https://mixpanel.com/settings/project  → Access Token
VITE_MIXPANEL_TOKEN=

# ─── Optional: feature flags ─────────────────────────────────────────────
# Toggle landing-page promotions, beta gates, etc.
VITE_ENABLE_BETA_CODE_GATE=false
