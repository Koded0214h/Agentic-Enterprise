        )
        read_only_fields = ('user', 'invoice_number', 'total_amount', 'status', 'created_at', 'updated_at')
    def create(self, validated_data):
        invoice_items_data = validated_data.pop('invoice_items', [])
        invoice = Invoice.objects.create(**validated_data)
        for item_data in invoice_items_data:
            InvoiceItem.objects.create(invoice=invoice, **item_data)
        invoice.save() # Recalculate total and potentially generate invoice number
        return invoice
    def update(self, instance, validated_data):
        invoice_items_data = validated_data.pop('invoice_items', [])
        # Update invoice fields
        for attr, value in validated_data.items():
            setattr(instance, attr, value)
        instance.save()
        # Handle invoice items: create new, update existing, delete removed
        existing_item_ids = {item.id for item in instance.invoice_items.all()}
        new_item_ids = set()
        for item_data in invoice_items_data:
            item_id = item_data.get('id')
            if item_id:
                new_item_ids.add(item_id)
                try:
                    item = instance.invoice_items.get(id=item_id)
                    for attr, value in item_data.items():
                        setattr(item, attr, value)
                    item.save()
                except InvoiceItem.DoesNotExist:
                    # Handle case where item_id is provided but doesn't exist (e.g., race condition)
                    pass # Or log an error
            else:
                # Create new item
                item = InvoiceItem.objects.create(invoice=instance, **item_data)
                new_item_ids.add(item.id)
        # Delete items that were in the invoice but not in the new data
        items_to_delete = existing_item_ids - new_item_ids
        instance.invoice_items.filter(id__in=items_to_delete).delete()
        instance.save() # Final save to ensure total is updated
        return instance
    def validate_client(self, value):
        # Ensure the client belongs to the current user
        if value.user != self.context['request'].user:
            raise serializers.ValidationError("You do not have permission to use this client.")
        return value
