# models.py (within a Django app, e.g., 'invoicing')
from django.db import models
from django.conf import settings
from django.utils import timezone
import uuid
class Client(models.Model):
    """Represents a client of the freelance designer."""
    id = models.UUIDField(primary_key=True, default=uuid.uuid4, editable=False)
    user = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.CASCADE, related_name='clients')
    name = models.CharField(max_length=255, blank=False)
    email = models.EmailField(blank=True, null=True)
    address = models.TextField(blank=True, null=True)
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    class Meta:
        unique_together = ('user', 'name') # Ensure unique client names per user
        ordering = ['name']
    def __str__(self):
        return self.name
class Invoice(models.Model):
    """Represents an invoice sent to a client."""
    class StatusChoices(models.TextChoices):
        DRAFT = 'DRAFT', 'Draft'
        SENT = 'SENT', 'Sent'
        PAID = 'PAID', 'Paid'
        OVERDUE = 'OVERDUE', 'Overdue' # This status can be managed via a scheduled task
    id = models.UUIDField(primary_key=True, default=uuid.uuid4, editable=False)
    user = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.CASCADE, related_name='invoices')
    client = models.ForeignKey(Client, on_delete=models.PROTECT, related_name='invoices') # PROTECT to prevent deleting clients with invoices
    invoice_number = models.CharField(max_length=50, blank=True, unique=False) # Will be generated or user-defined
    issue_date = models.DateField(default=timezone.now)
    due_date = models.DateField()
    total_amount = models.DecimalField(max_digits=10, decimal_places=2, default=0.00)
    status = models.CharField(
        max_length=10,
        choices=StatusChoices.choices,
        default=StatusChoices.DRAFT
    )
    notes = models.TextField(blank=True, null=True)
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    class Meta:
        ordering = ['-issue_date', '-invoice_number']
    def __str__(self):
        return f"Invoice {self.invoice_number} for {self.client.name}"
    def save(self, *args, **kwargs):
        # Auto-generate invoice number if not provided and status is not DRAFT
        if not self.invoice_number and self.status != self.StatusChoices.DRAFT:
            # Simple sequential numbering per user, could be more sophisticated
            last_invoice = Invoice.objects.filter(user=self.user).order_by('-invoice_number').first()
            if last_invoice:
                try:
                    # Attempt to increment if it's a number
                    self.invoice_number = str(int(last_invoice.invoice_number) + 1)
                except ValueError:
                    # Fallback if invoice_number is not purely numeric
                    self.invoice_number = f"INV-{timezone.now().year}-{Invoice.objects.filter(user=self.user).count() + 1}"
            else:
                self.invoice_number = "1"
        # Update total amount based on InvoiceItems
        self.total_amount = sum(item.line_total for item in self.invoice_items.all())
        super().save(*args, **kwargs)
class InvoiceItem(models.Model):
    """Represents a single line item on an invoice."""
    id = models.UUIDField(primary_key=True, default=uuid.uuid4, editable=False)
    invoice = models.ForeignKey(Invoice, on_delete=models.CASCADE, related_name='invoice_items')
    description = models.CharField(max_length=255, blank=False)
    quantity = models.DecimalField(max_digits=10, decimal_places=2, default=1.00)
    unit_price = models.DecimalField(max_digits=10, decimal_places=2, blank=False)
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    @property
    def line_total(self):
        return self.quantity * self.unit_price
    class Meta:
        ordering = ['description']
    def __str__(self):
        return f"{self.description} ({self.quantity} x {self.unit_price})"
    def save(self, *args, **kwargs):
        # Ensure invoice total is updated when items are added/modified
        super().save(*args, **kwargs)
        self.invoice.save() # Trigger save on parent invoice to update total_amount
