        read_only_fields = ('email', 'first_name', 'last_name') # Assuming these are managed elsewhere or not editable via API
class ClientSerializer(serializers.ModelSerializer):
    user = serializers.HiddenField(default=serializers.CurrentUserDefault())
    class Meta:
        model = Client
        fields = '__all__'
        read_only_fields = ('user', 'created_at', 'updated_at')
    def validate(self, data):
        # Ensure client name is unique for the current user
        user = self.context['request'].user
        name = data.get('name')
        if name and Client.objects.filter(user=user, name=name).exists():
            raise serializers.ValidationError({"name": "A client with this name already exists."})
        return data
