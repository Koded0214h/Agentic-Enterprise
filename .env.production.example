# ─── AOS Production Environment ────────────────────────────────────────────
# Copy to .env on the server. Never commit .env with real values.

# ─── Django Core ────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-python-secrets-token-urlsafe-50
DEBUG=0
ALLOWED_HOSTS=YOUR_SUBDOMAIN.duckdns.org,localhost
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN.vercel.app

# ─── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# Get this from: console.neon.tech → your project → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Redis (local, via docker-compose) ──────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ─── LLM API Keys ───────────────────────────────────────────────────────────
# GEMINI_API_KEY is required by default — the swarm defaults to Gemini 2.5 Flash.
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ─── Swarm default engine ───────────────────────────────────────────────────
# Platform default model for agent runs. Override to switch cost/quality tier.
AOS_DEFAULT_PROVIDER=gemini
AOS_DEFAULT_MODEL=gemini-2.5-flash

# ─── GitHub Container Registry (for CI/CD pull) ─────────────────────────────
# Set on the server so docker-compose can pull the image
GITHUB_REPOSITORY=koded0214h/agentic-enterprise
IMAGE_TAG=latest

# ─── DuckDNS ────────────────────────────────────────────────────────────────
DUCKDNS_TOKEN=your-duckdns-token
DUCKDNS_DOMAIN=your-subdomain

# ─── Optional ───────────────────────────────────────────────────────────────
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN.vercel.app
