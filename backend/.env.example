# ─────────────────────────────────────────────────────────────────────────
# AOS Backend Environment Variables
#
# Copy this file to `.env` (or set in your hosting platform: Render / Fly /
# Railway / your own server) and fill in the values. Every key documents
# whether it's required and where to obtain it.
# ─────────────────────────────────────────────────────────────────────────

# ─── Core Django ────────────────────────────────────────────────────────
# REQUIRED: generate with `python -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=replace-me-with-a-50-char-random-string

# 1 = debug, 0 = production. Set to 0 in production.
DEBUG=1

# Comma-separated list of allowed Host headers
ALLOWED_HOSTS=localhost,127.0.0.1,agentic-enterprise-smoky.vercel.app

# Public URL of the frontend (used in invite/reset-password email links)
FRONTEND_URL=https://agentic-enterprise-smoky.vercel.app

# ─── Database (Postgres) ─────────────────────────────────────────────────
# REQUIRED in production. Render automatically provides this.
# Local dev: SQLite is used if unset.
# DATABASE_URL=postgresql://user:pass@host:5432/aos

# ─── Redis (queue + pub/sub) ─────────────────────────────────────────────
# REQUIRED for Celery worker + SSE event streaming.
# Upstash gives a free 10k req/day tier — get the connection string from
# https://console.upstash.com/redis  (Database → REST/Redis URL).
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379

# ─── LLM Providers ───────────────────────────────────────────────────────
# At least ONE is required for agents to run.
# Anthropic console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Mistral console: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Ollama (local inference, optional): https://ollama.com/download
OLLAMA_BASE_URL=http://localhost:11434

# ─── Email — Gmail SMTP (default) ────────────────────────────────────────
# Two vars and you're done.
#   1. https://myaccount.google.com/security  → turn on 2-Step Verification
#   2. https://myaccount.google.com/apppasswords  → generate one for "Mail"
#   3. Paste the 16-char password below (spaces OK; they get stripped)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# From address shown to recipients. Defaults to GMAIL_USER if blank.
EMAIL_FROM=

# Contact form lands here
CONTACT_FORM_RECIPIENT=

# Optional override for non-Gmail SMTP (Mailgun, AWS SES, Postmark SMTP…)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ─── Error tracking + session replay ─────────────────────────────────────
# Sentry: https://sentry.io/settings/projects/  (Project → Client Keys (DSN))
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
AOS_ENV=production
AOS_RELEASE=1.0.0-beta

# ─── Product analytics (server-side relay) ───────────────────────────────
# PostHog: https://app.posthog.com/project/settings  (Project API Key)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Mixpanel (alternative): https://mixpanel.com/settings/project (Access Token)
MIXPANEL_TOKEN=

# ─── Admin notifications via Discord ─────────────────────────────────────
# Create a webhook in your Discord server: Server Settings → Integrations →
# Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=

# ─── OAuth / SSO (sign in with Google / GitHub) ──────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
# Create OAuth Client ID (Web), add the frontend origin to authorized origins.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers → New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── MCP tool credentials (optional — fill what you use) ─────────────────
# GitHub bot token (for the GitHub MCP server):
GITHUB_TOKEN=

# Slack bot token: https://api.slack.com/apps → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=

# Telegram bot: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API: https://developers.facebook.com/apps/  (Meta Business)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Discord bot token (for Discord MCP server, separate from webhook):
DISCORD_BOT_TOKEN=

# Google Calendar OAuth client (different from sign-in client is OK):
# https://console.cloud.google.com/apis/credentials  (enable Calendar API first)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Graph (Outlook/Teams):
# https://entra.microsoft.com → App registrations → New
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Twitter / X (for marketing analytics):
# https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# LinkedIn (marketing analytics):
# https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta / Facebook Ads:
# https://developers.facebook.com/apps/  → Marketing API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ─── Knowledge base (vector store) ───────────────────────────────────────
# Local Chroma is default. Pinecone is optional drop-in:
# https://app.pinecone.io/  → API keys
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
