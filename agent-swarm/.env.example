# AOS Control Plane — agent-swarm integration
# Copy to .env and fill in values. Leave AOS_BASE_URL empty to run without AOS.

# Base URL of the AOS Django backend (no trailing slash)
AOS_BASE_URL=http://localhost:8000

# JWT access token — obtain via POST /api/token/ with swarm-system credentials
AOS_TOKEN=

# Execution environment reported to AOS for policy evaluation
# Options: dev | staging | prod
AOS_ENV=dev
