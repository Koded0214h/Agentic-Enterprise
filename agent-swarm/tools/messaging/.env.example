# ─── WhatsApp Business Cloud API ────────────────────────────────────────────
WHATSAPP_TOKEN=your_meta_permanent_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_secret_string
# WHATSAPP_VERSION=v20.0    # optional, default is v20.0

# ─── Telegram Bot ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdef...   # from @BotFather
OWNER_TELEGRAM_ID=987654321              # your numeric Telegram user ID
# ALLOWED_USER_IDS=111111,222222        # extra allowed users, comma-separated
# TELEGRAM_BOT_MODE=polling             # "polling" (default) or "webhook"
# BOT_WEBHOOK_URL=https://yourdomain.com/
# BOT_WEBHOOK_SECRET=random_secret

# ─── Slack ──────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_SIGNING_SECRET=your_slack_signing_secret

# ─── Email — SendGrid (preferred) ───────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# SENDGRID_FROM_NAME=AOS Enterprise Agent

# ─── Email — SMTP fallback (used when SENDGRID_API_KEY is not set) ──────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM_NAME=AOS Agent

# ─── Bot / LLM ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OWNER_WHATSAPP_NUMBER=+2348012345678
# BOT_MODEL=claude-sonnet-4-6          # default model for bots

# ─── AOS Control Plane (optional — bots work fine without it) ───────────────
# AOS_BASE_URL=http://localhost:8000
# AOS_TOKEN=your_aos_jwt_or_api_token
