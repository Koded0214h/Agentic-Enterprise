# ── Conversation Hub ──────────────────────────────────────────────────────────
# Comma-separated owner IDs (Telegram chat_id / WhatsApp number / Slack user_id)
# Only these IDs can use /hub_* management commands
HUB_OWNER_IDS=123456789

# Claude model for agent responses (haiku = fast/cheap, sonnet = smarter)
HUB_LLM_MODEL=claude-haiku-4-5-20251001

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────────────────────
META_WHATSAPP_TOKEN=your_meta_access_token_here
META_WHATSAPP_PHONE_ID=your_phone_number_id_here
META_WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# ── Slack ──────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── AOS Backend (optional — for policy gate) ──────────────────────────────────
AOS_BASE_URL=http://localhost:8000
SWARM_API_KEY=your_swarm_api_key_here

# ── Storage paths (optional — defaults to ~/.swarm/hub/) ──────────────────────
# SWARM_HUB_ROUTES=/custom/path/routes.json
# SWARM_HUB_HISTORY=/custom/path/history.json
